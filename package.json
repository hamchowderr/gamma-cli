{
  "name": "@chowderr/gamma-cli",
  "version": "0.1.0",
  "description": "Terminal client for Gamma API — create AI-powered presentations, documents, and more from the command line",
  "type": "module",
  "bin": {
    "gamma": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "keywords": [
    "gamma",
    "presentation",
    "slides",
    "document",
    "ai",
    "cli",
    "generator"
  ],
  "license": "MIT",
  "author": "chowderr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamchowderr/gamma-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hamchowderr/gamma-cli/issues"
  },
  "homepage": "https://github.com/hamchowderr/gamma-cli#readme",
  "dependencies": {
    "@chowderr/gamma-sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "columnify": "^1.6.0",
    "commander": "^14.0.0",
    "@inquirer/prompts": "^7.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/columnify": "^1.5.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
